{
  "seed": 17,
  "sweep": {
    "seeds": [
      17
    ],
    "output_dir": "runs/2-Exp-45_encoder_architecture_smoke",
    "scenarios": [
      {
        "name": "series_mean",
        "overrides": {}
      }
    ]
  },
  "dataset": {
    "name": "synthetic_retail",
    "n_series": 128,
    "days": 14,
    "hours": 24,
    "forecast_days": 1,
    "recent_days": 7,
    "valid_ratio": 0.15,
    "test_ratio": 0.15,
    "noise_std": 0.15,
    "stockout_rate": 0.06
  },
  "model": {
    "hidden_dim": 40,
    "global_dim": 4,
    "local_dim": 4,
    "day_dim": 4,
    "hour_dim": 4,
    "interaction_dim": 3,
    "dropout": 0.1
  },
  "loss": {
    "decouple_weight": 0.001,
    "component_constraint_weight": 0.0,
    "residual_bias_weight": 0.0,
    "series_residual_bias_weight": 0.0
  },
  "residual": {
    "baseline_method": "series_mean",
    "target": "baseline_residual"
  },
  "diagnostics": {
    "n_permutations": 0
  },
  "calibration": {
    "enabled": false
  },
  "swap_regularization": {
    "enabled": false,
    "weight": 0.05
  },
  "probes": {
    "enabled": false
  },
  "output": {
    "save_latent_arrays": false,
    "save_residual_predictions": false,
    "save_checkpoints": false,
    "save_hour_heatmap": false
  },
  "train": {
    "batch_size": 32,
    "epochs": 6,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "num_workers": 0,
    "pin_memory": false,
    "amp": true,
    "reset_seed_per_variant": true,
    "selection_metric": "valid_loss_residual_reconstruction",
    "device": "auto",
    "output_dir": "runs/2-Exp-45_encoder_architecture_smoke/base",
    "early_stopping_patience": 1,
    "early_stopping_min_delta": 0.0
  },
  "experiments": [
    {
      "name": "day_gru_hour_mlp",
      "type": "output_decomposition",
      "center_components": true,
      "use_interaction": true,
      "day_encoder": "gru",
      "hour_encoder": "mlp"
    },
    {
      "name": "day_mlp_hour_mlp",
      "type": "output_decomposition",
      "center_components": true,
      "use_interaction": true,
      "day_encoder": "mlp",
      "hour_encoder": "mlp"
    },
    {
      "name": "day_mlpwide_hour_mlp",
      "type": "output_decomposition",
      "center_components": true,
      "use_interaction": true,
      "day_encoder": "mlp_wide",
      "hour_encoder": "mlp"
    },
    {
      "name": "day_gru_hour_gru",
      "type": "output_decomposition",
      "center_components": true,
      "use_interaction": true,
      "day_encoder": "gru",
      "hour_encoder": "gru"
    },
    {
      "name": "day_gru_hour_mlpwide",
      "type": "output_decomposition",
      "center_components": true,
      "use_interaction": true,
      "day_encoder": "gru",
      "hour_encoder": "mlp_wide"
    },
    {
      "name": "day_mlp_hour_gru",
      "type": "output_decomposition",
      "center_components": true,
      "use_interaction": true,
      "day_encoder": "mlp",
      "hour_encoder": "gru"
    }
  ]
}
